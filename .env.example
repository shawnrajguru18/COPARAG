# ── Required for the chatbot ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # used only for embeddings (text-embedding-3-small)

# ── ChromaDB (optional overrides) ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=copa_knowledge

# ── SharePoint ingestion (only needed for `python ingest.py --sharepoint`) ───
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret

# SharePoint site ID — find it with:
#   python -m rag.sharepoint_client --list-sites
SHAREPOINT_SITE_ID=your-tenant.sharepoint.com,site-guid,web-guid

# Document library and folder path
SHAREPOINT_DRIVE_NAME=Shared Documents
SHAREPOINT_FOLDER=Accelya
