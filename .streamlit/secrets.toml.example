# Copa Knowledge Assistant — Streamlit Secrets
# ─────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud: paste the key=value pairs into
#   App Settings → Secrets  (omit the comments and section headers).

# Required: Anthropic API key (for Claude answers)
ANTHROPIC_API_KEY = "sk-ant-..."

# Required: OpenAI API key (for text-embedding-3-small)
OPENAI_API_KEY = "sk-..."

# Pinecone — add these to use the persistent cloud vector store (recommended
# for 300 MB+ SharePoint content).  When present, the app skips in-memory
# re-indexing and queries the pre-built Pinecone index directly.
# Leave commented out to fall back to in-memory ChromaDB (good for the sample PDF).
#
# PINECONE_API_KEY   = "pcsk_..."
# PINECONE_INDEX_NAME = "copa-knowledge"   # optional, this is the default
